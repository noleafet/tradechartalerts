DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://tradechartalert:tradechartalert_dev@localhost:5432/tradechartalert
# Compose uses these values for its PostgreSQL container and app connections.
POSTGRES_DB=tradechartalert
POSTGRES_USER=tradechartalert
POSTGRES_PASSWORD=tradechartalert_dev
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
FRONTEND_PORT=3000
BACKEND_PORT=8000
FRONTEND_URL=https://tca.noleafet.blitz.cloud
BACKEND_URL=https://tca-admin.noleafet.blitz.cloud
SITE_VISIT_URL=https://tradechartalerts.vercel.app/
# Optional; defaults to every 10 minutes (600 seconds).
SITE_VISIT_INTERVAL_SECONDS=600
